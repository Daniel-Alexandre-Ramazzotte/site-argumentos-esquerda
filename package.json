{
  "name": "brasil-em-evidencias",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "format": "prettier --write app tests *.ts *.json README.md",
    "start": "next start --hostname 127.0.0.1",
    "db:setup": "node scripts/setup-database.mjs",
    "db:up": "docker compose up -d postgres",
    "db:import": "tsx --env-file=.env scripts/import-postgres.ts",
    "db:verify": "tsx --env-file=.env scripts/verify-postgres.ts"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "pg": "^8.23.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0"
  }
}
